# Copy this file to .env (next to docker-compose.yml) and fill in what you need.
# Everything is optional. .env is git-ignored: never commit real keys.

# --- Login ---
# Empty = no login. When both are set, the browser asks for this user name and password (HTTP Basic auth).
AUDITRACK_USERNAME=
AUDITRACK_PASSWORD=

# --- MCP server at /mcp ---
# Empty = no token check (when the login above is on, only audiTrack's own AI features can use MCP).
# When set, MCP clients must send "Authorization: Bearer <token>". Generate one with: openssl rand -hex 32
AUDITRACK_MCP_TOKEN=

# --- Database ---
# Empty = built-in database (embedded PostgreSQL) in the auditrack-data volume. Nothing else needed.
# Your own PostgreSQL server:
#   DATABASE_URL=postgresql://user:password@host:5432/auditrack?sslmode=require
# The bundled PostgreSQL container: also set COMPOSE_PROFILES=postgres (and POSTGRES_PASSWORD before the first start):
#   COMPOSE_PROFILES=postgres
#   POSTGRES_PASSWORD=change-me
#   DATABASE_URL=postgresql://auditrack:change-me@db:5432/auditrack?sslmode=disable
DATABASE_URL=

# --- AI: assistant, translation, report summaries and AI setup ---
# Configure one or more providers. AI_PROVIDER picks one; empty = the first configured one
# in this order: azure, anthropic, openai, openrouter, ollama.

# Anthropic (Claude). Model default: claude-opus-5-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenAI. Model default: gpt-4.1
OPENAI_API_KEY=
OPENAI_MODEL=

# Azure OpenAI. The deployment name is the model.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# OpenRouter. A model is required, e.g. anthropic/claude-opus-5-5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Ollama (local: your data never leaves your machine). A model is required, e.g. llama3.1
# Ollama running on the same machine as Docker: http://host.docker.internal:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Provider for all AI features: azure, anthropic, openai, openrouter or ollama. Empty = first configured.
AI_PROVIDER=
# Model override for the chosen provider. Empty = that provider's model above.
AI_MODEL=
